{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/monitoring-handoff.schema.json",
  "title": "MAT-081 monitoring handoff 1.0.0: wire shape only, not authority or a runtime adapter",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/refusal"
    }
  ],
  "$defs": {
    "known_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value",
        "precision"
      ],
      "properties": {
        "state": {
          "const": "known"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{3}|\\.[0-9]{6}|\\.[0-9]{9})?Z(?![\\s\\S])",
          "format": "matter-utc-time"
        },
        "precision": {
          "enum": [
            "second",
            "millisecond",
            "microsecond",
            "nanosecond"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "precision": {
                "const": "second"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "millisecond"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "microsecond"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z(?![\\s\\S])"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "nanosecond"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z(?![\\s\\S])"
              }
            }
          }
        }
      ]
    },
    "time_value": {
      "oneOf": [
        {
          "$ref": "#/$defs/known_time"
        },
        {
          "$ref": "#/$defs/unknown_time"
        }
      ]
    },
    "unknown_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason"
      ],
      "properties": {
        "state": {
          "const": "unknown"
        },
        "reason": {
          "enum": [
            "not_reported",
            "not_observed",
            "source_unavailable",
            "conflicting_evidence",
            "not_applicable"
          ]
        },
        "detail": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "component_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/text"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "not": {
        "pattern": "[\\u0000-\\u0020\\u007f]"
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007f]+(?![\\s\\S])",
      "not": {
        "pattern": "[\\u0000-\\u0020\\u007f]"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "minLength": 64,
      "maxLength": 64
    },
    "pinned_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "namespace",
        "record_type",
        "id"
      ],
      "properties": {
        "scope_id": {
          "$ref": "#/$defs/identifier"
        },
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "record_type": {
          "$ref": "#/$defs/reference_kind"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "oneOf": [
        {
          "required": [
            "revision"
          ],
          "not": {
            "required": [
              "digest"
            ]
          }
        },
        {
          "required": [
            "digest"
          ],
          "not": {
            "required": [
              "revision"
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "record_type": {
                "enum": [
                  "observation",
                  "claim",
                  "association_proposal",
                  "judgment",
                  "assessment",
                  "control",
                  "receipt"
                ]
              }
            }
          },
          "then": {
            "required": [
              "digest"
            ]
          }
        }
      ],
      "description": "Exactly one immutable digest or aggregate revision. Immutable core record kinds require a digest. Mutable aggregate dependencies may pin a revision or the digest of a specific immutable revision snapshot. Namespaced external kinds declare their own pin interpretation."
    },
    "reference_kind": {
      "anyOf": [
        {
          "enum": [
            "observation",
            "occurrence",
            "matter",
            "claim",
            "evidence_relation",
            "association_proposal",
            "accepted_association",
            "matter_relation",
            "judgment",
            "assessment",
            "control",
            "receipt"
          ]
        },
        {
          "$ref": "#/$defs/namespaced_name"
        }
      ]
    },
    "namespaced_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:[.:/][A-Za-z0-9][A-Za-z0-9_.:/-]*)+(?![\\s\\S])",
      "not": {
        "pattern": "[\\u0000-\\u0020\\u007f]"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "uri"
          ],
          "properties": {
            "kind": {
              "const": "whole_artifact"
            },
            "uri": {
              "type": "string",
              "minLength": 1,
              "format": "uri"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "uri",
            "selector"
          ],
          "properties": {
            "kind": {
              "const": "selected_span"
            },
            "uri": {
              "type": "string",
              "minLength": 1,
              "format": "uri"
            },
            "selector": {
              "$ref": "#/$defs/domain_value"
            },
            "validation_receipt": {
              "$ref": "#/$defs/receipt_ref"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unavailable"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "domain_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "value"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/component_ref"
        },
        "value": {}
      },
      "description": "An explicitly schema-bound domain value. The core preserves the value losslessly but does not interpret it, authorize it, or validate the external domain schema."
    },
    "receipt_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/entity_ref"
        },
        {
          "properties": {
            "record_type": {
              "const": "receipt"
            }
          }
        }
      ]
    },
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "namespace",
        "record_type",
        "id"
      ],
      "properties": {
        "scope_id": {
          "$ref": "#/$defs/identifier"
        },
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "record_type": {
          "$ref": "#/$defs/reference_kind"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "quiet_reason": {
      "enum": [
        "no_material_change",
        "already_delivered",
        "recovery_established",
        "handled_by_owner",
        "disposition_applies",
        "deferred_until_checkpoint",
        "budget_limited",
        "insufficient_evidence",
        "incomplete_coverage",
        "stale_assessment",
        "cancelled",
        "no_active_purpose"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
    },
    "text2000": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "host_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "workspace_id",
        "client_id",
        "jurisdiction_key"
      ],
      "properties": {
        "user_id": {
          "$ref": "#/$defs/id"
        },
        "workspace_id": {
          "$ref": "#/$defs/id"
        },
        "client_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "jurisdiction_key": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u0020\\u007f]+(?![\\s\\S])"
        }
      }
    },
    "approved_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision_id",
        "revision_number",
        "content_hash",
        "approval",
        "purpose",
        "scope",
        "concepts",
        "interests",
        "exclusions",
        "requested_events",
        "positions",
        "responsibility",
        "active_from",
        "active_until",
        "defaults",
        "preference"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision_id": {
          "$ref": "#/$defs/id"
        },
        "revision_number": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor_id",
            "approved_at"
          ],
          "properties": {
            "kind": {
              "const": "subscriber_approved"
            },
            "actor_id": {
              "$ref": "#/$defs/id"
            },
            "approved_at": {
              "$ref": "#/$defs/known_time"
            }
          }
        },
        "purpose": {
          "$ref": "#/$defs/text2000"
        },
        "scope": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "entity_type",
                "entity_id"
              ],
              "properties": {
                "kind": {
                  "const": "record"
                },
                "entity_type": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,49}(?![\\s\\S])"
                },
                "entity_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "objective_id"
              ],
              "properties": {
                "kind": {
                  "const": "objective"
                },
                "objective_id": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          ]
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 50
        },
        "interests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 50
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 50
        },
        "requested_events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 50
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provision",
              "position",
              "origin"
            ],
            "properties": {
              "provision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "position": {
                "enum": [
                  "proponent",
                  "opponent",
                  "neutral",
                  "unknown"
                ]
              },
              "origin": {
                "const": "user_approved"
              }
            }
          },
          "minItems": 0,
          "maxItems": 32
        },
        "responsibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner_id"
          ],
          "properties": {
            "owner_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "active_from": {
          "$ref": "#/$defs/known_time"
        },
        "active_until": {
          "anyOf": [
            {
              "$ref": "#/$defs/known_time"
            },
            {
              "type": "null"
            }
          ]
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "profile_reference"
          ],
          "properties": {
            "mode": {
              "const": "snapshot"
            },
            "profile_reference": {
              "anyOf": [
                {
                  "$ref": "#/$defs/component_ref"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "preference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channels",
            "cadence"
          ],
          "properties": {
            "channels": {
              "const": [
                "in_app"
              ]
            },
            "cadence": {
              "enum": [
                "immediate",
                "digest"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "properties": {
                  "kind": {
                    "const": "objective"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "concepts": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "scope",
        "audience",
        "responsibility",
        "preference"
      ],
      "properties": {
        "purpose": {
          "$ref": "#/$defs/component_ref"
        },
        "scope": {
          "$ref": "#/$defs/component_ref"
        },
        "audience": {
          "$ref": "#/$defs/component_ref"
        },
        "responsibility": {
          "$ref": "#/$defs/component_ref"
        },
        "preference": {
          "$ref": "#/$defs/component_ref"
        }
      }
    },
    "capture_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "watchlist_id",
        "watchlist_item_id",
        "activity_event_id",
        "user_activity_event_id"
      ],
      "properties": {
        "watchlist_id": {
          "$ref": "#/$defs/id"
        },
        "watchlist_item_id": {
          "$ref": "#/$defs/id"
        },
        "activity_event_id": {
          "$ref": "#/$defs/id"
        },
        "user_activity_event_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "available_at",
        "occurred_at",
        "published_at",
        "effective_at",
        "artifact_sha256",
        "selected_text_sha256",
        "locator",
        "origin",
        "parents"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/pinned_ref"
        },
        "available_at": {
          "$ref": "#/$defs/time_value"
        },
        "occurred_at": {
          "$ref": "#/$defs/time_value"
        },
        "published_at": {
          "$ref": "#/$defs/time_value"
        },
        "effective_at": {
          "$ref": "#/$defs/time_value"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selected_text_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "origin": {
          "enum": [
            "source",
            "derived",
            "adapter"
          ]
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pinned_ref"
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "derived"
              }
            }
          },
          "then": {
            "properties": {
              "parents": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_packet_id",
        "packet_digest",
        "knowledge_cut",
        "coverage",
        "coverage_reason",
        "sources",
        "correction_of",
        "occurrences"
      ],
      "properties": {
        "host_packet_id": {
          "$ref": "#/$defs/id"
        },
        "packet_digest": {
          "$ref": "#/$defs/sha256"
        },
        "knowledge_cut": {
          "$ref": "#/$defs/known_time"
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "coverage_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "correction_of": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pinned_ref"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pinned_ref"
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": {
                "enum": [
                  "partial",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "coverage_reason": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "baseline_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "workspace_id",
        "client_id",
        "intent_id"
      ],
      "properties": {
        "user_id": {
          "$ref": "#/$defs/id"
        },
        "workspace_id": {
          "$ref": "#/$defs/id"
        },
        "client_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "intent_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "baseline": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "no_observed_output"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "receipt",
            "owner",
            "intent_revision_id",
            "assessment_reference",
            "conveyed_material_digest"
          ],
          "properties": {
            "status": {
              "enum": [
                "observed_capture",
                "observed_delivery"
              ]
            },
            "receipt": {
              "$ref": "#/$defs/pinned_ref"
            },
            "owner": {
              "$ref": "#/$defs/baseline_owner"
            },
            "intent_revision_id": {
              "$ref": "#/$defs/id"
            },
            "assessment_reference": {
              "$ref": "#/$defs/pinned_ref"
            },
            "conveyed_material_digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "attempt_id"
          ],
          "properties": {
            "status": {
              "const": "outcome_unknown"
            },
            "attempt_id": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "questions",
        "provider",
        "model",
        "adapter",
        "qualification"
      ],
      "properties": {
        "policy": {
          "$ref": "#/$defs/component_ref"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component_ref"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "provider": {
          "$ref": "#/$defs/component_ref"
        },
        "model": {
          "$ref": "#/$defs/id"
        },
        "adapter": {
          "$ref": "#/$defs/component_ref"
        },
        "qualification": {
          "const": "unqualified"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_calls",
        "timeout_seconds",
        "wall_seconds",
        "max_request_bytes",
        "max_response_bytes",
        "max_cost_usd",
        "price_basis"
      ],
      "properties": {
        "max_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_cost_usd": {
          "type": "string",
          "pattern": "^(?=[0-9.]*[1-9])(0|[1-9][0-9]*)(\\.[0-9]+)?(?![\\s\\S])"
        },
        "price_basis": {
          "$ref": "#/$defs/component_ref"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "contract_version",
        "request_id",
        "idempotency_key",
        "mode",
        "host_binding",
        "intent",
        "context_components",
        "context_selection",
        "evidence",
        "baseline",
        "dispositions",
        "capture_binding",
        "evaluation",
        "budgets"
      ],
      "properties": {
        "message_type": {
          "const": "monitoring_request"
        },
        "contract_version": {
          "const": "monitoring-handoff/1.0.0"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "idempotency_key": {
          "$ref": "#/$defs/id"
        },
        "mode": {
          "enum": [
            "rehearsal_capture",
            "live_shadow_capture"
          ]
        },
        "host_binding": {
          "$ref": "#/$defs/host_binding"
        },
        "intent": {
          "$ref": "#/$defs/approved_intent"
        },
        "context_components": {
          "$ref": "#/$defs/components"
        },
        "context_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "effective_at"
          ],
          "properties": {
            "policy": {
              "enum": [
                "retrospective_selected",
                "current"
              ]
            },
            "effective_at": {
              "$ref": "#/$defs/known_time"
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        },
        "dispositions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pinned_ref"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "capture_binding": {
          "$ref": "#/$defs/capture_binding"
        },
        "evaluation": {
          "$ref": "#/$defs/evaluation"
        },
        "budgets": {
          "$ref": "#/$defs/budgets"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "rehearsal_capture"
              }
            }
          },
          "then": {
            "properties": {
              "context_selection": {
                "properties": {
                  "policy": {
                    "const": "retrospective_selected"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "live_shadow_capture"
              }
            }
          },
          "then": {
            "properties": {
              "context_selection": {
                "properties": {
                  "policy": {
                    "const": "current"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/quiet_reason"
        },
        {
          "enum": [
            "material_change",
            "critical_fact",
            "correction_delta",
            "reserved_decision_required",
            "preference_applies",
            "material_contract_change",
            "no_relevance",
            "inactive_audience",
            "provider_unavailable",
            "semantic_unknown"
          ]
        }
      ]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "locator",
        "selected_text_sha256"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/pinned_ref"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "selected_text_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "contract_version",
        "request_id",
        "result_id",
        "outcome",
        "treatment",
        "intent_revision_id",
        "evidence_packet_digest",
        "context_components",
        "source_finding_reference",
        "assessment_reference",
        "reasons",
        "citations",
        "coverage",
        "uncertainty",
        "qualification",
        "permitted_use",
        "currentness",
        "dependencies",
        "baseline_reference",
        "proposed_next_steps"
      ],
      "properties": {
        "message_type": {
          "const": "monitoring_result"
        },
        "contract_version": {
          "const": "monitoring-handoff/1.0.0"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "result_id": {
          "$ref": "#/$defs/id"
        },
        "outcome": {
          "const": "proposal"
        },
        "treatment": {
          "enum": [
            "quiet",
            "host_hint",
            "digest",
            "update",
            "correction",
            "decision_request"
          ]
        },
        "intent_revision_id": {
          "$ref": "#/$defs/id"
        },
        "evidence_packet_digest": {
          "$ref": "#/$defs/sha256"
        },
        "context_components": {
          "$ref": "#/$defs/components"
        },
        "source_finding_reference": {
          "$ref": "#/$defs/pinned_ref"
        },
        "assessment_reference": {
          "$ref": "#/$defs/pinned_ref"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 32
        },
        "qualification": {
          "const": "unqualified"
        },
        "permitted_use": {
          "const": "capture_only"
        },
        "currentness": {
          "const": "guard_required_before_capture"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pinned_ref"
          },
          "minItems": 1,
          "maxItems": 128
        },
        "baseline_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/pinned_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposed_next_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 8
        }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "contract_version",
        "request_id",
        "code",
        "reason"
      ],
      "properties": {
        "message_type": {
          "const": "monitoring_refusal"
        },
        "contract_version": {
          "const": "monitoring-handoff/1.0.0"
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "enum": [
            "E_SCHEMA_INVALID",
            "E_VERSION_UNSUPPORTED",
            "E_SCOPE_FORBIDDEN",
            "E_AUTHORITY_REQUIRED",
            "E_DEPENDENCY_STALE",
            "E_EVIDENCE_UNAVAILABLE",
            "E_POLICY_INVALID",
            "E_BUDGET_EXHAUSTED",
            "E_CANCELLED",
            "E_DELIVERY_UNKNOWN",
            "E_IDEMPOTENCY_CONFLICT"
          ]
        },
        "reason": {
          "enum": [
            "invalid_request",
            "unsupported_version",
            "access_forbidden",
            "host_controls_unavailable",
            "context_changed",
            "source_unavailable",
            "capture_binding_missing",
            "capture_binding_invalid",
            "provider_not_configured",
            "resource_limit",
            "host_cancelled",
            "outcome_unknown",
            "idempotency_conflict"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "request_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "E_SCHEMA_INVALID",
                  "E_VERSION_UNSUPPORTED"
                ]
              },
              "reason": {
                "enum": [
                  "invalid_request",
                  "unsupported_version"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
