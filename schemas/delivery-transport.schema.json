{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/delivery-transport.schema.json",
  "title": "Matter delivery-transport v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "id",
    "version",
    "producer",
    "success_milestone",
    "idempotency",
    "receipt_lookup"
  ],
  "properties": {
    "namespace": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespace"
    },
    "id": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
    },
    "producer": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "success_milestone": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
    },
    "idempotency": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "retention_ms"
          ],
          "properties": {
            "scope": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
            },
            "retention_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31536000000
            }
          }
        }
      ]
    },
    "receipt_lookup": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "reliable_terminal"
          ],
          "properties": {
            "scope": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
            },
            "reliable_terminal": {
              "const": true
            }
          }
        }
      ]
    }
  }
}
