{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/negative-dependency.schema.json",
  "title": "Matter negative dependency v1",
  "description": "A scope-bound negative dependency retaining its original knowledge boundary, coverage and catalog pins. Arrival invalidation preserves historical evidence and does not assert absence, execute assessment, or grant authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_id",
    "watch",
    "reference",
    "coverage_snapshot",
    "catalogs",
    "status",
    "matches",
    "indeterminate",
    "invalidation",
    "policy",
    "authority"
  ],
  "properties": {
    "scope_id": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "watch": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/negative_watch"
    },
    "reference": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/pinned_ref"
    },
    "coverage_snapshot": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
    },
    "catalogs": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
      },
      "maxItems": 64
    },
    "status": {
      "enum": [
        "current",
        "unusable_coverage",
        "evidence_present",
        "indeterminate",
        "invalidated"
      ]
    },
    "matches": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/observation_dependency"
      },
      "maxItems": 4096
    },
    "indeterminate": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/observation_dependency"
      },
      "maxItems": 4096
    },
    "invalidation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observation",
            "receipt",
            "eligibility"
          ],
          "properties": {
            "observation": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/observation_dependency"
            },
            "receipt": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_ref"
            },
            "eligibility": {
              "enum": [
                "matched",
                "indeterminate"
              ]
            }
          }
        }
      ]
    },
    "policy": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "authority": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
    }
  }
}
