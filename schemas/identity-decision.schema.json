{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/identity-decision.schema.json",
  "title": "Matter immutable merge and correction decision v1",
  "description": "Frozen full-group partitions, retained child snapshots, effective ownership changes, conflicts, protections and dependency changes. No source evidence is rewritten and no semantic equivalence is inferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_id",
    "kind",
    "authority",
    "policy",
    "basis",
    "as_of",
    "previous",
    "before",
    "after",
    "children",
    "conflicts",
    "protections",
    "changes",
    "actor",
    "policy_definition"
  ],
  "properties": {
    "scope_id": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "kind": {
      "enum": [
        "merge",
        "undo",
        "split"
      ]
    },
    "authority": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
    },
    "policy": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "basis": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/pinned_ref"
      },
      "minItems": 1
    },
    "as_of": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
    },
    "previous": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
        }
      ]
    },
    "before": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "survivor",
          "members",
          "indexes"
        ],
        "properties": {
          "survivor": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/matter_dependency"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/matter_dependency"
            },
            "minItems": 1
          },
          "indexes": {
            "type": "array",
            "items": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
            },
            "minItems": 0
          }
        }
      },
      "minItems": 1
    },
    "after": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "survivor",
          "members",
          "indexes"
        ],
        "properties": {
          "survivor": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/matter_dependency"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/matter_dependency"
            },
            "minItems": 1
          },
          "indexes": {
            "type": "array",
            "items": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
            },
            "minItems": 0
          }
        }
      },
      "minItems": 1
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "original_matters",
          "before",
          "after",
          "action",
          "record_action"
        ],
        "properties": {
          "reference": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/pinned_ref"
          },
          "original_matters": {
            "type": "array",
            "items": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/matter_ref"
            },
            "minItems": 1
          },
          "before": {
            "type": "array",
            "items": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/matter_ref"
            },
            "minItems": 1
          },
          "after": {
            "type": "array",
            "items": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/matter_ref"
            },
            "minItems": 1
          },
          "action": {
            "enum": [
              "retained",
              "moved",
              "shared",
              "invalidated"
            ]
          },
          "record_action": {
            "enum": [
              "retained",
              "revisioned"
            ]
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "references",
          "reason"
        ],
        "properties": {
          "kind": {
            "enum": [
              "overlapping_claims",
              "shared_evidence",
              "overlapping_associations",
              "overlapping_links",
              "metadata_difference"
            ]
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/pinned_ref"
            },
            "minItems": 2
          },
          "reason": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
          }
        }
      }
    },
    "protections": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
      },
      "minItems": 0
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/dependency_change"
      },
      "minItems": 1
    },
    "actor": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/actor_ref"
    },
    "policy_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "actors",
        "authorities",
        "allow_correction",
        "capability"
      ],
      "properties": {
        "scope_id": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
        },
        "actors": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/actor_ref"
          },
          "minItems": 1
        },
        "authorities": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
          },
          "minItems": 1
        },
        "allow_correction": {
          "type": "boolean"
        },
        "capability": {
          "const": "merge"
        }
      }
    }
  }
}
