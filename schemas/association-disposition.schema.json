{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/association-disposition.schema.json",
  "title": "Matter bounded association disposition v1",
  "description": "A durable scoped decision for an ordered attachment/relation pair or symmetric merge separation. Blocked dispositions remain effective across new proposals until explicitly released; merge execution and general control epochs are separate work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_id",
    "subject",
    "target",
    "relation",
    "capability",
    "status",
    "kind",
    "reason",
    "authority",
    "policy",
    "decision",
    "previous",
    "as_of"
  ],
  "properties": {
    "scope_id": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "subject": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/association_member_ref"
    },
    "target": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/association_member_ref"
    },
    "relation": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "capability": {
      "enum": [
        "attach",
        "relate",
        "merge"
      ]
    },
    "status": {
      "enum": [
        "blocked",
        "released"
      ]
    },
    "kind": {
      "enum": [
        "reject",
        "protect",
        "release"
      ]
    },
    "reason": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
    },
    "authority": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_ref"
    },
    "policy": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "decision": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
    },
    "previous": {
      "oneOf": [
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "release"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "released"
          }
        }
      },
      "else": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      }
    }
  ]
}
