{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/association-decision.schema.json",
  "title": "Matter immutable association decision details v1",
  "description": "Host-authorized decision bound to scoped bare identities and the exact policy and relation descriptor. An evaluation receipt is not an authority grant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_id",
    "subject",
    "target",
    "relation",
    "capability",
    "decision",
    "reason",
    "authority",
    "policy",
    "previous",
    "proposal",
    "as_of"
  ],
  "properties": {
    "scope_id": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "subject": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/association_member_ref"
    },
    "target": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/association_member_ref"
    },
    "relation": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "capability": {
      "enum": [
        "attach",
        "relate",
        "merge"
      ]
    },
    "decision": {
      "enum": [
        "accept",
        "reject",
        "protect",
        "release"
      ]
    },
    "reason": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
    },
    "authority": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_ref"
    },
    "policy": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "previous": {
      "oneOf": [
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposal": {
      "oneOf": [
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/association_proposal_dependency"
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
    }
  }
}
