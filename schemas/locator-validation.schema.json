{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/locator-validation.schema.json",
  "title": "Matter locator-validation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_id",
    "evidence",
    "content",
    "locator",
    "quotation",
    "adapter",
    "dependencies",
    "checked_at",
    "result"
  ],
  "properties": {
    "scope_id": {
      "$ref": "core-record.schema.json#/$defs/identifier"
    },
    "evidence": {
      "$ref": "core-record.schema.json#/$defs/pinned_ref"
    },
    "content": {
      "oneOf": [
        {
          "$ref": "core-record.schema.json#/$defs/source_content"
        },
        {
          "type": "null"
        }
      ]
    },
    "locator": {
      "$ref": "core-record.schema.json#/$defs/locator"
    },
    "quotation": {
      "oneOf": [
        {
          "$ref": "core-record.schema.json#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "adapter": {
      "$ref": "core-record.schema.json#/$defs/component_ref"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "core-record.schema.json#/$defs/pinned_ref"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "checked_at": {
      "$ref": "core-record.schema.json#/$defs/known_time"
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "kind",
            "selection_digest"
          ],
          "properties": {
            "status": {
              "const": "valid"
            },
            "kind": {
              "enum": [
                "exact_passage",
                "whole_artifact"
              ]
            },
            "selection_digest": {
              "$ref": "core-record.schema.json#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "invalid",
                "unavailable"
              ]
            },
            "reason": {
              "$ref": "core-record.schema.json#/$defs/text"
            }
          }
        }
      ]
    }
  }
}
