{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/timer-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "definition",
    "token",
    "manifest",
    "status",
    "next_index",
    "created_at",
    "updated_at",
    "last_firing",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "namespace",
        "id",
        "semantic_version",
        "condition_id",
        "generation",
        "matter",
        "assessment",
        "profile",
        "purpose",
        "audience",
        "rules",
        "dependencies",
        "checkpoints",
        "expires_at",
        "max_clock_skew_ms"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "namespace": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespace"
        },
        "id": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
        },
        "semantic_version": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
        },
        "condition_id": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
        },
        "generation": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/revision"
        },
        "matter": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/matter_dependency"
        },
        "assessment": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/assessment_dependency"
        },
        "profile": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
        },
        "purpose": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
        },
        "audience": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/pinned_ref"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "at"
            ],
            "properties": {
              "id": {
                "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
              },
              "at": {
                "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
              }
            }
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "expires_at": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
        },
        "max_clock_skew_ms": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/counter"
        }
      }
    },
    "token": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/domain_value"
    },
    "manifest": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/domain_value"
    },
    "status": {
      "enum": [
        "active",
        "completed",
        "cancelled",
        "expired",
        "inert"
      ]
    },
    "next_index": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/counter"
    },
    "created_at": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
    },
    "updated_at": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
    },
    "last_firing": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
        }
      ]
    },
    "reason": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
    }
  }
}
