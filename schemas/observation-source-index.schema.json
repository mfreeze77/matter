{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/observation-source-index.schema.json",
  "title": "Matter observation source index v1",
  "description": "Internal schema-bound projection value, not another core record. Entries append in commit order; immutable observations retain all original evidence and receipt data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "entries"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "namespace", "event_id"],
      "properties": {
        "scope_id": {"$ref": "core-record.schema.json#/$defs/identifier"},
        "namespace": {"$ref": "core-record.schema.json#/$defs/namespace"},
        "event_id": {"$ref": "core-record.schema.json#/$defs/identifier"}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation", "evidence_digest", "payload_digest"],
        "properties": {
          "observation": {"$ref": "core-record.schema.json#/$defs/observation_dependency"},
          "evidence_digest": {"$ref": "core-record.schema.json#/$defs/sha256"},
          "payload_digest": {"$ref": "core-record.schema.json#/$defs/sha256"},
          "revision_id": {"$ref": "core-record.schema.json#/$defs/identifier"}
        }
      }
    }
  }
}
