{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/budget-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "id",
    "semantic_version",
    "kind",
    "window",
    "limits",
    "units",
    "description"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "namespace": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespace"
    },
    "id": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "semantic_version": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "kind": {
      "enum": [
        "resource",
        "attention"
      ]
    },
    "window": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/time_interval"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "calls": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/counter"
        },
        "input_bytes": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/counter"
        },
        "output_bytes": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/counter"
        },
        "elapsed_ms": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/counter"
        },
        "candidates": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/counter"
        },
        "retries": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/counter"
        },
        "cost_units": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/counter"
        },
        "deliveries": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/counter"
        },
        "interruption_units": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/counter"
        }
      },
      "minProperties": 1
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calls": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
        },
        "input_bytes": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
        },
        "output_bytes": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
        },
        "elapsed_ms": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
        },
        "candidates": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
        },
        "retries": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
        },
        "cost_units": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
        },
        "deliveries": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
        },
        "interruption_units": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
        }
      }
    },
    "description": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
    }
  }
}
