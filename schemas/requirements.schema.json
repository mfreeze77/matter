{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/requirements.schema.json",
  "title": "Matter requirement inventory v1",
  "type": "array", "minItems": 1,
  "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "description", "source"], "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"},
    "title": {"type": "string", "minLength": 5},
    "description": {"type": "string", "minLength": 20},
    "source": {"type": "string", "minLength": 1}
  }}
}
