{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/candidate-set.schema.json",
  "title": "Matter declared association candidate catalog v1",
  "description": "Host-published candidates and coverage within one explicit query. The service checks scope, source records, policy, and authority. This catalog does not discover external candidates or bind continuing matter identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_id",
    "query",
    "subject",
    "entries",
    "coverage",
    "evidence",
    "as_of",
    "policy",
    "authority"
  ],
  "properties": {
    "scope_id": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "query": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/association_query"
    },
    "subject": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/association_member_dependency"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/association_candidate_entry"
      }
    },
    "coverage": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/coverage"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/pinned_ref"
      }
    },
    "as_of": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
    },
    "policy": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "authority": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_ref"
    }
  }
}
