{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/delivery-observation.schema.json",
  "title": "Matter factual delivery observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization",
    "intent",
    "destination",
    "transport",
    "delivery_key",
    "status",
    "receipt_id",
    "reported_at",
    "observed_at",
    "ordering",
    "reason",
    "eligibility_at_observation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "authorization": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
    },
    "intent": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
    },
    "destination": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "transport": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "delivery_key": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "status": {
      "enum": [
        "delivered",
        "failed",
        "delivery_unknown",
        "withheld",
        "consumed",
        "acted_on",
        "outcome_verified",
        "useful"
      ]
    },
    "receipt_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
        }
      ]
    },
    "reported_at": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/time_value"
    },
    "observed_at": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
    },
    "ordering": {
      "enum": [
        "transport_time",
        "unavailable"
      ]
    },
    "reason": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
    },
    "eligibility_at_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "error_code",
        "checked_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "current",
            "invalidated"
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/error_code"
            }
          ]
        },
        "checked_at": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
        }
      }
    }
  }
}
