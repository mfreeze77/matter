{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/identity-release.schema.json",
  "title": "Matter explicit identity separation release v1",
  "description": "Host-authorized release of specifically pinned protected separations. Groups, redirects, evidence and matter revisions do not change; a later merge must independently pass all guards.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_id",
    "actor",
    "authority",
    "policy",
    "policy_definition",
    "basis",
    "reason",
    "as_of",
    "separations",
    "changes"
  ],
  "properties": {
    "scope_id": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "actor": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/actor_ref"
    },
    "authority": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
    },
    "policy": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "policy_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "actors",
        "authorities",
        "allow_correction",
        "capability"
      ],
      "properties": {
        "scope_id": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
        },
        "actors": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/actor_ref"
          },
          "minItems": 1
        },
        "authorities": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
          },
          "minItems": 1
        },
        "allow_correction": {
          "type": "boolean"
        },
        "capability": {
          "const": "merge"
        }
      }
    },
    "basis": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/pinned_ref"
      },
      "minItems": 1
    },
    "reason": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
    },
    "as_of": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
    },
    "separations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "before",
          "after",
          "members",
          "protected_by"
        ],
        "properties": {
          "before": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
          },
          "after": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/matter_ref"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "protected_by": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
          }
        }
      },
      "minItems": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/dependency_change"
      },
      "minItems": 1
    }
  }
}
