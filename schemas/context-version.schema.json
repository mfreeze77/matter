{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/context-version.schema.json",
  "title": "Matter context-version v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_id",
    "definition",
    "control"
  ],
  "properties": {
    "scope_id": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "namespace",
        "id",
        "semantic_version",
        "kind",
        "description",
        "applies_to",
        "effective_from",
        "effective_until",
        "content"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "namespace": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
        },
        "id": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
        },
        "semantic_version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "purpose",
            "objective",
            "audience",
            "responsibility",
            "preference"
          ]
        },
        "description": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
        },
        "applies_to": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/entity_ref"
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "effective_from": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
        },
        "effective_until": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/time_value"
        },
        "content": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "purpose"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "objectives",
                  "constraints"
                ],
                "properties": {
                  "objectives": {
                    "type": "array",
                    "items": {
                      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
                    },
                    "maxItems": 128,
                    "uniqueItems": true
                  },
                  "constraints": {
                    "type": "array",
                    "items": {
                      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
                    },
                    "maxItems": 128,
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "objective"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "statement",
                  "constraints"
                ],
                "properties": {
                  "statement": {
                    "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
                  },
                  "constraints": {
                    "type": "array",
                    "items": {
                      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
                    },
                    "maxItems": 128,
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "audience"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "audience_id",
                  "audience_kind",
                  "purposes",
                  "responsibilities",
                  "preferences"
                ],
                "properties": {
                  "audience_id": {
                    "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
                  },
                  "audience_kind": {
                    "enum": [
                      "human",
                      "host_agent",
                      "role"
                    ]
                  },
                  "purposes": {
                    "type": "array",
                    "items": {
                      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
                    },
                    "maxItems": 128,
                    "uniqueItems": true
                  },
                  "responsibilities": {
                    "type": "array",
                    "items": {
                      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
                    },
                    "maxItems": 128,
                    "uniqueItems": true
                  },
                  "preferences": {
                    "type": "array",
                    "items": {
                      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
                    },
                    "maxItems": 128,
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "responsibility"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "capabilities",
                  "purposes"
                ],
                "properties": {
                  "owner": {
                    "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/actor_ref"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "read",
                        "write",
                        "association",
                        "merge",
                        "correction",
                        "transition",
                        "assessment",
                        "delivery"
                      ]
                    },
                    "maxItems": 128,
                    "uniqueItems": true
                  },
                  "purposes": {
                    "type": "array",
                    "items": {
                      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
                    },
                    "maxItems": 128,
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "preference"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "preferred_treatment",
                  "channels",
                  "interruption_budget"
                ],
                "properties": {
                  "preferred_treatment": {
                    "enum": [
                      "quiet",
                      "host_hint",
                      "digest",
                      "update",
                      "correction",
                      "decision_request"
                    ]
                  },
                  "channels": {
                    "type": "array",
                    "items": {
                      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
                    },
                    "maxItems": 128,
                    "uniqueItems": true
                  },
                  "interruption_budget": {
                    "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/domain_value"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "control": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/control_dependency"
    }
  }
}
