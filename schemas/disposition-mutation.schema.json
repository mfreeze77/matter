{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/disposition-mutation.schema.json",
  "title": "Matter disposition-mutation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "definition",
    "previous"
  ],
  "properties": {
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "namespace",
        "kind",
        "matter",
        "purpose",
        "audience",
        "subject",
        "effective_from",
        "effective_until",
        "reason",
        "decision",
        "status"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "namespace": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespace"
        },
        "kind": {
          "enum": [
            "acknowledgement",
            "deferral",
            "rejection",
            "decision"
          ]
        },
        "matter": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/matter_ref"
        },
        "purpose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "context"
          ],
          "properties": {
            "reference": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
            },
            "context": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
            }
          }
        },
        "audience": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "context"
          ],
          "properties": {
            "reference": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
            },
            "context": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
            }
          }
        },
        "subject": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/pinned_ref"
        },
        "effective_from": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
        },
        "effective_until": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/time_value"
        },
        "reason": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/domain_value"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "active",
            "withdrawn"
          ]
        }
      }
    },
    "previous": {
      "anyOf": [
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
