{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/control-effect.schema.json",
  "title": "Matter control effect v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "reason",
    "capabilities"
  ],
  "properties": {
    "action": {
      "enum": [
        "cancel",
        "resume",
        "deny",
        "allow",
        "invalidate",
        "disposition"
      ]
    },
    "reason": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "association",
          "merge",
          "correction",
          "transition",
          "read",
          "delivery",
          "assessment",
          "write"
        ]
      },
      "uniqueItems": true
    },
    "payload": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/domain_value"
    }
  }
}
