{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/attention-request.schema.json",
  "title": "Matter attention-request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "policy",
    "assessment",
    "contexts",
    "subject",
    "lifecycle",
    "token",
    "access_context",
    "captured_at",
    "previous",
    "previous_registration",
    "baseline",
    "delivery_receipt"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "action": {
      "enum": [
        "evaluate",
        "record_delivered"
      ]
    },
    "policy": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "assessment": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/assessment_dependency"
    },
    "contexts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "audience",
        "responsibilities",
        "preferences"
      ],
      "properties": {
        "purpose": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
        },
        "audience": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "preferences": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
          },
          "maxItems": 16,
          "uniqueItems": true
        }
      }
    },
    "subject": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/pinned_ref"
    },
    "lifecycle": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "condition"
          ],
          "properties": {
            "profile": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
            },
            "condition": {}
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "token": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/domain_value"
    },
    "access_context": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "captured_at": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
    },
    "previous": {
      "anyOf": [
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_registration": {
      "anyOf": [
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/domain_value"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseline": {
      "anyOf": [
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
        },
        {
          "type": "null"
        }
      ]
    },
    "delivery_receipt": {
      "anyOf": [
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
