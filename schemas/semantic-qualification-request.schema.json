{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/semantic-qualification-request.schema.json",
  "title": "Matter semantic-qualification-request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "token",
    "measure",
    "previous",
    "previous_registration",
    "access_context",
    "captured_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "token": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/domain_value"
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit"
      ],
      "properties": {
        "name": {
          "enum": [
            "probability",
            "confidence",
            "choice_probability",
            "score"
          ]
        },
        "unit": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
        }
      }
    },
    "previous": {
      "anyOf": [
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_registration": {
      "anyOf": [
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/domain_value"
        },
        {
          "type": "null"
        }
      ]
    },
    "access_context": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "captured_at": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
    }
  }
}
