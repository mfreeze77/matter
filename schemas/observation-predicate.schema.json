{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/observation-predicate.schema.json",
  "title": "Matter observation predicate v1",
  "description": "A closed deterministic observation predicate. Empty clauses match every observation in the separately declared source and time scope; source identity, qualification, permission and truth are not inferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "clauses"
  ],
  "properties": {
    "record_type": {
      "const": "observation"
    },
    "clauses": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "equals"
            ],
            "properties": {
              "field": {
                "enum": [
                  "record_namespace",
                  "source_event_id",
                  "source_revision_id",
                  "origin",
                  "media_type"
                ]
              },
              "equals": {
                "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "key",
              "schema",
              "value"
            ],
            "properties": {
              "field": {
                "const": "extension"
              },
              "key": {
                "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
              },
              "schema": {
                "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
              },
              "value": {
                "description": "Exact extension value under the declared schema, compared using matter-json-v1 canonical bytes. Canonical preflight is required; this field does not execute or authorize its content."
              }
            }
          }
        ]
      },
      "maxItems": 64
    }
  }
}
