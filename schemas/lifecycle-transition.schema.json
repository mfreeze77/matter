{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/lifecycle-transition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matter",
    "profile",
    "edge",
    "trigger",
    "condition",
    "from_state",
    "to_state",
    "lifecycle_revision",
    "effective_at",
    "knowledge_at",
    "basis",
    "previous_transition",
    "decision",
    "control_token",
    "assessment_publication"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "matter": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/matter_dependency"
    },
    "profile": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "edge": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "trigger": {
      "enum": [
        "establish",
        "resolution",
        "recurrence",
        "retraction",
        "correction"
      ]
    },
    "condition": {},
    "from_state": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
    },
    "to_state": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
    },
    "lifecycle_revision": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/revision"
    },
    "effective_at": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
    },
    "knowledge_at": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "occurrence",
        "assessment"
      ],
      "properties": {
        "claim": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/claim_dependency"
        },
        "occurrence": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/occurrence_dependency"
        },
        "assessment": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/assessment_dependency"
        }
      }
    },
    "previous_transition": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
        }
      ]
    },
    "decision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/control_dependency"
        }
      ]
    },
    "control_token": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/domain_value"
    },
    "assessment_publication": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/domain_value"
    }
  }
}
