{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/delivery-request.schema.json",
  "title": "Matter delivery-request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "intent",
    "intent_payload",
    "expected_slot",
    "lease",
    "attempt_id",
    "authorization",
    "observation",
    "budget_command",
    "captured_at",
    "authorization_proof",
    "observation_kind",
    "withheld_reason",
    "evidence",
    "outcome_producer"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "action": {
      "enum": [
        "queue",
        "claim",
        "authorize",
        "observe",
        "reconcile",
        "withhold"
      ]
    },
    "intent": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
        }
      ]
    },
    "intent_payload": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/domain_value"
        }
      ]
    },
    "expected_slot": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
        }
      ]
    },
    "lease": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "worker",
            "token",
            "fence",
            "expires_at"
          ],
          "properties": {
            "worker": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
            },
            "token": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
            },
            "fence": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/counter"
            },
            "expires_at": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
            }
          }
        }
      ]
    },
    "attempt_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
        }
      ]
    },
    "authorization": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
        }
      ]
    },
    "observation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/domain_value"
        }
      ]
    },
    "budget_command": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/domain_value"
        }
      ]
    },
    "captured_at": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
    },
    "authorization_proof": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "result"
          ],
          "properties": {
            "command": {
              "type": "object"
            },
            "result": {
              "type": "object"
            }
          }
        }
      ]
    },
    "observation_kind": {
      "enum": [
        null,
        "transport",
        "outcome"
      ]
    },
    "withheld_reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/quiet_reason"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/pinned_ref"
      }
    },
    "outcome_producer": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
        }
      ]
    }
  }
}
