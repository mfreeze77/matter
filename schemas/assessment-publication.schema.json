{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/assessment-publication.schema.json",
  "title": "assessment-publication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preparation",
    "graph",
    "interpretations",
    "cache_entries",
    "assessment_id",
    "built_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "preparation": {
      "type": "object"
    },
    "graph": {
      "type": "object"
    },
    "interpretations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object"
      }
    },
    "cache_entries": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object"
      }
    },
    "assessment_id": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "built_at": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
    }
  }
}
