{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/attention-result.schema.json",
  "title": "Matter attention result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "decision",
    "baseline",
    "treatment",
    "reasons",
    "dependencies"
  ],
  "properties": {
    "action": {
      "enum": [
        "evaluate",
        "record_delivered"
      ]
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseline": {
      "anyOf": [
        {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/projection_dependency"
        },
        {
          "type": "null"
        }
      ]
    },
    "treatment": {
      "enum": [
        "quiet",
        "host_hint",
        "digest",
        "update",
        "correction",
        "decision_request",
        null
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
      },
      "uniqueItems": true,
      "maxItems": 32
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/pinned_ref"
      },
      "maxItems": 4096,
      "uniqueItems": true
    }
  }
}
