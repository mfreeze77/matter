{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/investigation-definition.schema.json",
  "title": "Matter investigation-definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "id",
    "version",
    "matter",
    "proposition",
    "inputs",
    "requirements",
    "candidates",
    "retry_at",
    "information_gain_hypothesis"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "namespace": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespace"
    },
    "id": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
    },
    "matter": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/matter_dependency"
    },
    "proposition": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/domain_value"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/pinned_ref"
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "counterevidence"
        ],
        "properties": {
          "id": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
          },
          "description": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
          },
          "counterevidence": {
            "type": "boolean"
          }
        }
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "source_namespace",
          "uri",
          "requirements",
          "max_bytes",
          "timeout_ms"
        ],
        "properties": {
          "reference": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
          },
          "source_namespace": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespace"
          },
          "uri": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
          },
          "requirements": {
            "type": "array",
            "items": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
            },
            "maxItems": 32,
            "uniqueItems": true
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120000
          }
        }
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "retry_at": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
      },
      "maxItems": 16,
      "uniqueItems": true
    },
    "information_gain_hypothesis": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/text"
    }
  }
}
