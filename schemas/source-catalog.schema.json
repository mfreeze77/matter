{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/source-catalog.schema.json",
  "title": "Matter source catalog v1",
  "description": "A bounded source bucket retaining exact immutable observation pins. Baseline completeness is an explicit host declaration, not inferred from an empty catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_id",
    "source",
    "observations",
    "baseline",
    "admissions"
  ],
  "properties": {
    "scope_id": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "source": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identity_key"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/observation_dependency"
      },
      "maxItems": 4096
    },
    "baseline": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declared_at",
            "adapter",
            "authority",
            "catalog_revision"
          ],
          "properties": {
            "declared_at": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
            },
            "adapter": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
            },
            "authority": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/receipt_dependency"
            },
            "catalog_revision": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/revision"
            }
          }
        }
      ]
    },
    "admissions": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation",
          "catalog_revision"
        ],
        "properties": {
          "observation": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/observation_dependency"
          },
          "catalog_revision": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/revision"
          }
        }
      }
    }
  }
}
