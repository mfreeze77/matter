{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/civic-profile.schema.json",
  "title": "Optional civic profile v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "namespace": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespace"
    },
    "id": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "schema": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "common_profile": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "producer": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "producer_code_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_id": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "applies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jurisdiction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "act": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "jurisdiction",
        "body",
        "category",
        "act"
      ]
    },
    "effective": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
        },
        "end": {
          "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/time_value"
        },
        "bounds": {
          "const": "closed_open"
        }
      },
      "required": [
        "start",
        "end",
        "bounds"
      ]
    },
    "available_at": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/time_value"
    },
    "source_stages": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "parents": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
      },
      "maxItems": 8,
      "uniqueItems": true
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
          },
          "selector": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "jurisdiction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "act": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "jurisdiction",
              "body",
              "category",
              "act"
            ]
          },
          "capability": {
            "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/namespaced_name"
          },
          "allowed": {
            "type": "boolean"
          },
          "effective": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": {
                "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
              },
              "end": {
                "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/time_value"
              },
              "bounds": {
                "const": "closed_open"
              }
            },
            "required": [
              "start",
              "end",
              "bounds"
            ]
          },
          "disposition": {
            "enum": [
              "unreviewed",
              "supported_source",
              "reviewed_host",
              "disputed",
              "withdrawn",
              "unknown"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reference": {
                  "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/observation_dependency"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "reference",
                "sha256"
              ]
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "attestation": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/control_dependency"
              }
            ]
          },
          "overrides": {
            "type": "array",
            "items": {
              "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
            },
            "maxItems": 128,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "selector",
          "capability",
          "allowed",
          "effective",
          "disposition",
          "sources",
          "attestation",
          "overrides"
        ]
      },
      "maxItems": 128
    }
  },
  "required": [
    "schema_version",
    "namespace",
    "id",
    "version",
    "schema",
    "common_profile",
    "producer",
    "producer_code_sha256",
    "scope_id",
    "applies",
    "effective",
    "available_at",
    "source_stages",
    "parents",
    "assertions"
  ]
}
