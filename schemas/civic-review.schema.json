{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/matter/schemas/civic-review.schema.json",
  "title": "Explicit host civic authority review v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scope_id": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/identifier"
    },
    "assertion": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "common_profile": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/component_ref"
    },
    "disposition": {
      "enum": [
        "reviewed_host",
        "withdrawn",
        "disputed"
      ]
    },
    "reviewed_at": {
      "$ref": "https://github.com/mfreeze77/matter/schemas/core-record.schema.json#/$defs/known_time"
    }
  },
  "required": [
    "scope_id",
    "assertion",
    "common_profile",
    "disposition",
    "reviewed_at"
  ]
}
