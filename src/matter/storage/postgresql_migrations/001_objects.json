  "functions": [
    [
      "check_head_identity",
      "plpgsql",
      "v",
      false,
      false,
      "u",
      "trigger",
      "",
      [
        "search_path=@schema@, pg_temp"
      ],
      "\nBEGIN\n    IF EXISTS (SELECT 1 FROM versions WHERE scope_key = identity_key(NEW.scope_id)\n        AND namespace_key = identity_key(NEW.namespace) AND id_key = identity_key(NEW.id)\n        AND scope_id = NEW.scope_id\n        AND namespace = NEW.namespace AND id = NEW.id AND version = NEW.version\n        AND record_type <> NEW.record_type) THEN\n        RAISE EXCEPTION 'Matter head must retain version type.' USING ERRCODE = '23514';\n    END IF;\n    RETURN NEW;\nEND;\n"
    ],
    [
      "check_version_identity",
      "plpgsql",
      "v",
      false,
      false,
      "u",
      "trigger",
      "",
      [
        "search_path=@schema@, pg_temp"
      ],
      "\nDECLARE\n    previous_version bigint;\n    previous_type text;\nBEGIN\n    SELECT version, record_type INTO previous_version, previous_type FROM versions\n        WHERE scope_key = identity_key(NEW.scope_id)\n        AND namespace_key = identity_key(NEW.namespace) AND id_key = identity_key(NEW.id)\n        AND scope_id = NEW.scope_id AND namespace = NEW.namespace AND id = NEW.id\n        ORDER BY version DESC LIMIT 1;\n    IF NEW.version <> coalesce(previous_version + 1, 1) THEN\n        RAISE EXCEPTION 'Matter versions must be consecutive.' USING ERRCODE = '23514';\n    END IF;\n    IF previous_type IS NOT NULL AND previous_type <> NEW.record_type THEN\n        RAISE EXCEPTION 'Matter identity cannot change type.' USING ERRCODE = '23514';\n    END IF;\n    RETURN NEW;\nEND;\n"
    ],
    [
      "identity_key",
      "sql",
      "i",
      false,
      true,
      "s",
      "bytea",
      "25",
      [
        "search_path=pg_catalog"
      ],
      "\n    SELECT sha256(convert_to($1, 'UTF8'));\n"
    ],
    [
      "refuse_history_change",
      "plpgsql",
      "v",
      false,
      false,
      "u",
      "trigger",
      "",
      [
        "search_path=@schema@, pg_temp"
      ],
      "\nBEGIN\n    RAISE EXCEPTION 'Matter history is append-only.' USING ERRCODE = '23514';\nEND;\n"
    ]
  ]
